{
  "name": "almatracc",
  "version": "1.0.0",
  "description": "AlmaTracc - AMCS Alumni Network Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm start --prefix backend",
    "start:backend": "npm start --prefix backend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
